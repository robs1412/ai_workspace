#!/usr/bin/env bash
set -euo pipefail

cd /Users/werkstatt/ai_workspace
source /Users/werkstatt/ai_workspace/scripts/workspaceboard_session_context.sh

export CODEX_OWNER_USER_ID=3
export CODEX_OWNER_LABEL=Sonat
export CODEX_OWNER_ROLE=ai-manager-sonat
export CODEX_OWNER_WORKSPACE=ai

WB_HANDOFF_CONTEXT_ARGS=()
if [[ "${WORKSPACEBOARD_SESSION_ID:-}" =~ ^[a-f0-9]{8}([a-f0-9]{8})?$ ]]; then
  WB_HANDOFF_CONTEXT_ARGS=(-c "shell_environment_policy.set.WORKSPACEBOARD_SESSION_ID='${WORKSPACEBOARD_SESSION_ID}'")
fi

exec /usr/local/bin/codex -C /Users/werkstatt/ai_workspace ${WB_HANDOFF_CONTEXT_ARGS[@]+"${WB_HANDOFF_CONTEXT_ARGS[@]}"} \
  "CLI_OWNER_CONTEXT: Sonat is operating this Codex CLI session. CODEX_OWNER_USER_ID=3, CODEX_OWNER_LABEL=Sonat, CODEX_OWNER_ROLE=ai-manager-sonat. Load /Users/werkstatt/ai_workspace/worker_roles/ai-manager-sonat-startup.md, reply exactly READY AI Manager Sonat., and treat this as the AI Manager Sonat control lane. Do not infer Robert ownership from the shared /Users/werkstatt path, SSH host, or Unix account. Route substantive work through Task Manager / visible Workspaceboard workers and report to Sonat by default."
